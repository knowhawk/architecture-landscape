            <property key="NAF Steps" value="AD, MP, AG"/>
            <property key="ArchiMate Viewpoint" value="Motivation"/>
            <property key="Reference" value="NAF v4.1 ch. 3 (A8); NAF v4.1 ArchiMate Implementation Guide ch. 50"/>
          </element>
