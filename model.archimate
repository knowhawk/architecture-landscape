        </folder>
        <folder name="Business Interactions" id="id-5032eab56a3c4266ba3832fd6e6d61a4">
          <documentation>Generic Business Interaction element. See ArchiMate 3.2 Specification, chapter Business Layer.</documentation>
          <element xsi:type="archimate:BusinessInteraction" name="Business Interaction" id="id-a69267da8270443381b398d9bccec281">
            <documentation>Generic Business Interaction: the default meaning of this type in the template, used when an element carries no specialisation. See ArchiMate 3.2 Specification, chapter Business Layer.</documentation>
          </element>
        </folder>
        <folder name="Business Events" id="id-22c432912bd841d597ee6c9ac358bc49">
          <documentation>Generic Business Event element. See ArchiMate 3.2 Specification, chapter Business Layer.</documentation>
          <element xsi:type="archimate:BusinessEvent" name="Business Event" id="id-20e68c5f885d4f889a5d791163416d8a">
            <documentation>Generic Business Event: the default meaning of this type in the template, used when an element carries no specialisation. See ArchiMate 3.2 Specification, chapter Business Layer.</documentation>
          </element>
        </folder>
        <folder name="Business Services" id="id-d218e7ecfddf437ebfb993f1cca1860f">
          <documentation>Generic Business Service element. See ArchiMate 3.2 Specification, chapter Business Layer.</documentation>
          <element xsi:type="archimate:BusinessService" name="Business Service" id="id-92a787ebaa1f4db4a7c12530061d5c46">
            <documentation>Generic Business Service: the default meaning of this type in the template, used when an element carries no specialisation. See ArchiMate 3.2 Specification, chapter Business Layer.</documentation>
          </element>
        </folder>
        <folder name="Business Objects" id="id-81aafcad416e4b9695387b10f3a3f575">
          <documentation>Generic Business Object element. See ArchiMate 3.2 Specification, chapter Business Layer.</documentation>
          <element xsi:type="archimate:BusinessObject" name="Business Object" id="id-fa4d69794b8c4d689ffac9df416d6513">
            <documentation>Generic Business Object: the default meaning of this type in the template, used when an element carries no specialisation. See ArchiMate 3.2 Specification, chapter Business Layer.</documentation>
          </element>
        </folder>
        <folder name="Contracts" id="id-f6cd109c79554670bf03ee5ac32431e1">
          <documentation>Generic Contract element. See ArchiMate 3.2 Specification, chapter Business Layer.</documentation>
          <element xsi:type="archimate:Contract" name="Contract" id="id-acedf51b5db14b03b44b4fe5e7843e6e">
            <documentation>Generic Contract: the default meaning of this type in the template, used when an element carries no specialisation. See ArchiMate 3.2 Specification, chapter Business Layer.</documentation>
