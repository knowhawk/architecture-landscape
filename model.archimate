            <child xsi:type="archimate:DiagramObject" id="id-d1c3082db7d04c1a860f9037d3dce83e" targetConnections="id-55be7d28c1d640029201b046379cb59d" archimateElement="id-aa8f096dc2064f5dbf1b068a464123b5">
