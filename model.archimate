            <child xsi:type="archimate:DiagramObject" id="id-556c69b343e84fe288c66f093d3a7c6e" targetConnections="id-f15df4a64e3e475b96444edeb10dcbe5" archimateElement="id-f964c5f5a7ce463aa1405951ede93f17">
