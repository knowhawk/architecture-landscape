            <property key="NAF Grid Row" value="C – Concepts"/>
            <property key="NAF Grid Column" value="7 – Information"/>
            <property key="NAF Steps" value="AD, AE"/>
            <property key="ArchiMate Viewpoint" value="Requirements Realization"/>
            <property key="Reference" value="NAF v4.1 ch. 3 (C7); NAF v4.1 ArchiMate Implementation Guide ch. 10"/>
          </element>
