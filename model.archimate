            <property key="NAF Grid Row" value="C – Concepts"/>
            <property key="NAF Grid Column" value="5 – States"/>
            <property key="NAF Steps" value="AV, AD, AE"/>
            <property key="ArchiMate Viewpoint" value="Goal Realization"/>
            <property key="Reference" value="NAF v4.1 ch. 3 (C5); NAF v4.1 ArchiMate Implementation Guide ch. 9"/>
          </element>
