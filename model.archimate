            <child xsi:type="archimate:DiagramObject" id="id-1213484a16354c9fa71fc5ca1a0c3cdc" targetConnections="id-45c111fece7e47d8b45cd6b49909b813" archimateElement="id-412904a027804ea39a5cbe8612a62e8e">
