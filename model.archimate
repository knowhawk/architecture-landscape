  <folder name="Strategy" id="id-e69ccb88688e4299875754429a0b8069" type="strategy">
    <folder name="Reference Libraries" id="id-027ff1ab25ff4b9ea8cb22470dbd63d8">
      <folder name="ArchiMate Metamodel" id="id-b6018590ea354408b0b70e7c12c27046">
        <folder name="Resources" id="id-799b0faabea64d23b60e9448d023e0a5">
          <documentation>Generic Resource element. See ArchiMate 3.2 Specification, chapter Strategy Elements.</documentation>
          <element xsi:type="archimate:Resource" name="Resource" id="id-7d509c433dca41f8a55c73cfc4fe0c30">
            <documentation>Generic Resource: the default meaning of this type in the template, used when an element carries no specialisation. See ArchiMate 3.2 Specification, chapter Strategy Elements. Not used by the NAF ArchiMate Implementation Guide; available in this template (decision S1).</documentation>
          </element>
        </folder>
        <folder name="Capabilities" id="id-2cd6e44a04934a01a9cd45f2c8746075">
