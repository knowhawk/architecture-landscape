            <child xsi:type="archimate:DiagramObject" id="id-7797523c1f4646ac98b055f75702ee75" targetConnections="id-967c104fe7d74c4f8af53e6850af80a9" archimateElement="id-8e15b2d95d5c439eb4115bd8bb50bac8">
